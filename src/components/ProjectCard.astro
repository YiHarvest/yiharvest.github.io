---
interface Props {
  title: string;
  description: string;
  tags: string[];
  href: string;
  image: string;
  imageAlt: string;
  github?: string;
  featured?: boolean;
}

const {
  title,
  description,
  tags,
  href,
  image,
  imageAlt,
  github,
  featured = false,
} = Astro.props;
---

<article class:list={['project-card', featured && 'project-card--featured']} data-reveal>
  <a href={href} class="project-card__media" aria-label={`查看 ${title}`}>
    <img
      src={image}
      alt={imageAlt}
      width="1536"
      height="1024"
      loading={featured ? 'eager' : 'lazy'}
      data-project-art
    />
  </a>
  <div class="project-card__body">
    <div class="project-card__copy">
      <h3><a href={href}>{title}</a></h3>
      <p>{description}</p>
    </div>
    <div class="tag-list" aria-label="Technology tags">
      {tags.slice(0, 4).map(tag => <span>{tag}</span>)}
    </div>
    <div class="project-card__actions">
      <a href={href} class="text-link">查看详情</a>
      {github && (
        <a href={github} class="text-link text-link--muted" target="_blank" rel="noreferrer">
          GitHub
        </a>
      )}
    </div>
  </div>
</article>
