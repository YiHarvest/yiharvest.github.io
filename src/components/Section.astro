---
interface Props {
  title?: string;
  id?: string;
}

const { title, id } = Astro.props;
---

<section id={id} class="py-16 sm:py-24">
  <div class="max-w-[896px] mx-auto px-6">
    {title && (
      <h2 class="text-2xl font-semibold tracking-tight mb-8">
        {title}
      </h2>
    )}
    <slot />
  </div>
</section>