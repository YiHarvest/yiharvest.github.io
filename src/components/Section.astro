---
interface Props {
  title?: string;
  description?: string;
  id?: string;
  class?: string;
}

const { title, description, id, class: className } = Astro.props;
---

<section id={id} class:list={['section', className]}>
  <div class="section__inner">
    {title && (
      <header class="section__header" data-reveal>
        <h2>{title}</h2>
        {description && <p>{description}</p>}
      </header>
    )}
    <slot />
  </div>
</section>
