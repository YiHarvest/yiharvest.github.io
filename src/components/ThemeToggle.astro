<button
  id="theme-toggle"
  type="button"
  class="theme-toggle"
  aria-label="切换到深色模式"
  aria-pressed="false"
>
  <span class="theme-toggle__light" data-copy-lang="zh">深色</span>
  <span class="theme-toggle__light" data-copy-lang="en">Dark</span>
  <span class="theme-toggle__dark" data-copy-lang="zh">浅色</span>
  <span class="theme-toggle__dark" data-copy-lang="en">Light</span>
</button>

<script>
  const toggle = document.getElementById('theme-toggle');
  const syncToggle = () => {
    const isDark = document.documentElement.classList.contains('dark');
    const isEnglish = document.documentElement.dataset.language === 'en';
    toggle?.setAttribute(
      'aria-pressed',
      String(isDark),
    );
    toggle?.setAttribute(
      'aria-label',
      isEnglish
        ? (isDark ? 'Switch to light mode' : 'Switch to dark mode')
        : (isDark ? '切换到浅色模式' : '切换到深色模式'),
    );
  };

  syncToggle();
  toggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch {}
    syncToggle();
  });
  document.addEventListener('yiharvest:languagechange', syncToggle);
</script>
