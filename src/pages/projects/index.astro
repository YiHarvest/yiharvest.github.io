---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const orderedProjects = projects.sort((a, b) => a.data.priority - b.data.priority);
---

<BaseLayout
  title="项目"
  titleEn="Projects"
  description="YiHarvest 的 AI 基础设施、Agent 执行、故障诊断与开发者工具。"
  descriptionEn="AI infrastructure, agent execution, failure diagnostics, and developer tools by YiHarvest."
>
  <Navigation slot="navigation" />

  <header class="page-intro">
    <div class="page-intro__inner" data-enter>
      <h1><span data-copy-lang="zh">项目</span><span data-copy-lang="en">Projects</span></h1>
      <p class="page-intro__lede"><span data-copy-lang="zh">从多模态内容进入系统，到可靠执行、故障取证和开放网络访问。</span><span data-copy-lang="en">From multimodal ingestion to reliable execution, failure evidence, and open-web access.</span></p>
    </div>
  </header>

  <Section class="section--compact">
    <ProjectGrid>
      {orderedProjects.map((project, index) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          descriptionEn={project.data.descriptionEn}
          tags={project.data.tags}
          href={`/projects/${project.id.replace(/\.mdx$/, '')}`}
          image={project.data.image}
          imageAlt={project.data.imageAlt}
          imageAltEn={project.data.imageAltEn}
          github={project.data.github}
          featured={index === 0}
          origin={project.data.origin}
        />
      ))}
    </ProjectGrid>
  </Section>

  <Footer slot="footer" />
</BaseLayout>
