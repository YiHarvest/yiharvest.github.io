---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
---

<BaseLayout
  title="关于"
  titleEn="About"
  description="关于 YiHarvest 当前的工程方向、工作方式与技术判断。"
  descriptionEn="The current engineering direction, working principles, and technical judgment behind YiHarvest."
  image="/images/editorial-texture.webp"
>
  <Navigation slot="navigation" />

  <header class="about-hero">
    <div class="about-hero__inner">
      <div class="about-hero__copy" data-enter>
        <p class="eyebrow"><span data-copy-lang="zh">关于 YiHarvest</span><span data-copy-lang="en">About YiHarvest</span></p>
        <h1><span data-copy-lang="zh">把 AI 能力放进可靠系统。</span><span data-copy-lang="en">Putting AI capability inside reliable systems.</span></h1>
        <p><span data-copy-lang="zh">当前专注多模态内容基础设施、Agent 执行内核、故障证据与开放网络工具。模型能力只是起点，边界、恢复和可验证性决定系统能否被真正使用。</span><span data-copy-lang="en">Current work spans multimodal infrastructure, agent execution kernels, failure evidence, and open-web tools. Model capability is only the starting point; boundaries, recovery, and verifiability make a system usable.</span></p>
      </div>
      <figure class="editorial-art" data-page-art="about" data-enter>
        <img
          src="/images/editorial-texture.webp"
          alt="穿过半透明研究材料的深绿色纤维"
          data-i18n-attr="alt"
          data-zh="穿过半透明研究材料的深绿色纤维"
          data-en="Forest-green filaments passing through translucent research materials"
          width="1536"
          height="1024"
          fetchpriority="high"
        />
      </figure>
    </div>
  </header>

  <Section
    title="工作原则"
    titleEn="How I work"
    description="不追逐复杂本身。先理解失败方式、信任边界和真实操作路径，再选择技术。"
    descriptionEn="Start with failure modes, trust boundaries, and real operating paths, then choose the technology."
  >
    <div class="principle-grid">
      <article class="principle" data-enter>
        <h3><span data-copy-lang="zh">证据优先</span><span data-copy-lang="en">Evidence first</span></h3>
        <p><span data-copy-lang="zh">从来源、数据边界与验收方式开始，而不是从模型名称开始。</span><span data-copy-lang="en">Begin with provenance, data boundaries, and acceptance criteria, not a model name.</span></p>
      </article>
      <article class="principle" data-enter>
        <h3><span data-copy-lang="zh">系统思考</span><span data-copy-lang="en">Systems thinking</span></h3>
        <p><span data-copy-lang="zh">把输入、路由、执行、确认、恢复和观测看成同一个系统。</span><span data-copy-lang="en">Treat input, routing, execution, confirmation, recovery, and observation as one system.</span></p>
      </article>
      <article class="principle" data-enter>
        <h3><span data-copy-lang="zh">克制交付</span><span data-copy-lang="en">Useful restraint</span></h3>
        <p><span data-copy-lang="zh">清楚说明限制。界面、文档、默认值和失败信息都属于工程质量。</span><span data-copy-lang="en">State limits clearly. Interfaces, docs, defaults, and failure messages are engineering quality.</span></p>
      </article>
    </div>
  </Section>

  <Section
    title="技术关注"
    titleEn="Technical focus"
    description="TypeScript 与 Python 为主，覆盖 Next.js、FastAPI、MCP、数据与任务系统、模型适配和可观测性。"
    descriptionEn="Mostly TypeScript and Python across Next.js, FastAPI, MCP, data and job systems, model adapters, and observability."
  >
    <div class="contact-panel" data-enter>
      <h2><span data-copy-lang="zh">查看正在构建的系统。</span><span data-copy-lang="en">Explore the systems in progress.</span></h2>
      <div class="contact-panel__action">
        <a href="/projects" class="button button--primary"><span data-copy-lang="zh">浏览项目</span><span data-copy-lang="en">Browse projects</span></a>
      </div>
    </div>
  </Section>

  <Footer slot="footer" />
</BaseLayout>
